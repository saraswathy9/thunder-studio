pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '182719847108'
        AWS_REGION     = 'us-east-1'
        ECR_REPO_NAME  = 'thunder-studio'
        IMAGE_TAG      = "${BUILD_NUMBER}"
        REGISTRY_URL   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                git branch: 'main', url: 'https://github.com/YOUR_GITHUB_USERNAME/thunder-studio.git'
            }
        }

        stage('AWS ECR Login') {
            steps {
                sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${REGISTRY_URL}"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${ECR_REPO_NAME}:${IMAGE_TAG} ."
                sh "docker tag ${ECR_REPO_NAME}:${IMAGE_TAG} ${REGISTRY_URL}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                sh "docker tag ${ECR_REPO_NAME}:${IMAGE_TAG} ${REGISTRY_URL}/${ECR_REPO_NAME}:latest"
            }
        }

        stage('Push Image to AWS ECR') {
            steps {
                sh "docker push ${REGISTRY_URL}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                sh "docker push ${REGISTRY_URL}/${ECR_REPO_NAME}:latest"
            }
        }

        stage('Deploy to Amazon EKS Cluster') {
            steps {
                sh "aws eks update-kubeconfig --region ${AWS_REGION} --name thunder-eks-cluster"
                sh "kubectl apply -f k8s/deployment.yaml"
                sh "kubectl apply -f k8s/service.yaml"
                sh "kubectl rollout restart deployment/thunder-studio-deployment"
            }
        }
    }

    post {
        always {
            sh "docker image prune -f"
        }
    }
}
